# Step 1: Build stage
FROM node:20 AS build

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .
RUN npm run build   # creates production-ready build in /app/dist or /app/build

# Step 2: Serve the app
FROM nginx:alpine

COPY --from=build /app/dist /usr/share/nginx/html   # Vite build output 
# COPY --from=build /app/build /usr/share/nginx/html # CRA build output

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
